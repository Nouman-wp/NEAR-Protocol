# Quorum backend for one network: clearing service, agent swarm and edge proxy (scripts/serve.ts).
#   sudo systemctl enable --now quorum@testnet
[Unit]
Description=Quorum backend (%i)
After=network-online.target
Wants=network-online.target

[Service]
User=quorum
WorkingDirectory=/opt/quorum
ExecStart=/usr/bin/env corepack pnpm serve %i
Restart=always
RestartSec=10
# serve.ts stops the clearing service and the swarm itself on SIGTERM
KillMode=mixed
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
