# ─────────────────────────────────────────────────────────────────────────────
# Quorum configuration. `pnpm dev` and `pnpm sim` need no configuration at all: they
# run a local NEAR sandbox and derive every key from a public development seed.
#
# For testnet, `pnpm wallets testnet` writes .env.testnet with fresh keys; every script
# takes the network name and loads that file (QUORUM_ENV_FILE selects it for the services).
# Never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# local | testnet | mainnet
QUORUM_NETWORK=local
# NEAR_RPC_URL=https://rpc.testnet.near.org

# ── accounts and keys (public networks) ─────────────────────────────────────
# The named account that owns the contracts; every agent is its sub-account.
# QUORUM_ROOT=quorum-demo.testnet
# QUORUM_ROOT_KEY=ed25519:...
# Master seed: the clearer's and every agent's key follow from it and the account name.
# QUORUM_SEED=...

# ── deployment (pnpm deploy:<network>) ───────────────────────────────────────
# Empty: deploy Quorum's test USDC (6 decimals, open faucet). Required on mainnet.
SETTLEMENT_TOKEN=
# Empty: deploy intents-lite, a stand-in verifier. Mainnet: intents.near
QUORUM_INTENTS_CONTRACT=
# seconds a net debtor has to sign its transfers before its collateral covers the debt
SETTLEMENT_WINDOW=180
WITHDRAWAL_DELAY=3600
MIN_VALIDATOR_STAKE=1000000

# ── clearing service ─────────────────────────────────────────────────────────
PORT=8787
PUBLIC_API_URL=http://localhost:8787
EPOCH_INTAKE_SECONDS=75
EPOCH_CHALLENGE_SECONDS=18
DISPUTE_WINDOW_SECONDS=12
ARBITRATION_TIMEOUT_SECONDS=15
# IOUs per post_ious call (about 0.7 Tgas each, 300 Tgas per call)
POST_CHUNK_SIZE=120
# debtors' signed payloads per settle call, and how long to wait for the rest
SETTLE_CHUNK_SIZE=12
SETTLE_GATHER_SECONDS=6
WRITE_REPUTATION_ONCHAIN=true
REPUTATION_EPOCH_STRIDE=1
# keep an epoch with no IOUs open instead of finalising it empty (default: on, except local)
# EPOCH_EXTEND_IDLE=true
ADMIN_TOKEN=change-me
CORS_ORIGIN=*
# DATA_DIR=.data
# optional Supabase mirror of the ledger (server side only)
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=

# ── agent swarm ──────────────────────────────────────────────────────────────
FLEET_PORT=8788
PUBLIC_FLEET_URL=http://localhost:8788
CLEARING_URL=http://localhost:8787
# research, market, or both
FLEET_MODE=research,market
FLEET_BACKGROUND=on
BACKGROUND_INTERVAL_SECONDS=45
# the group-buy market: scripted buyers and sellers, no model calls
SIM_BUYERS=20
SIM_SELLERS=5
SIM_SEED=42
SIM_INTERVAL_SECONDS=30
# sealed-bid round windows
ROUND_JOIN_SECONDS=5
ROUND_COMMIT_SECONDS=6
ROUND_REVEAL_SECONDS=6
# what each agent keeps: collateral, money inside the verifier, NEAR for gas
COLLATERAL_TARGET=25
ORCHESTRATOR_COLLATERAL=100
INTENTS_TARGET=40
NEAR_TARGET=2
ROGUE_BAD_RATE=0.5
GUEST_SESSIONS_PER_HOUR=20

# ── website ──────────────────────────────────────────────────────────────────
VITE_QUORUM_API=http://localhost:8787
VITE_QUORUM_FLEET=http://localhost:8788
# VITE_QUORUM_WS=ws://localhost:8787
